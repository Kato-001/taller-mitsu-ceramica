# Apache (XAMPP / Laragon): todo pasa por el controlador frontal
Options -Indexes
RewriteEngine On

# Archivos públicos (CSS, JS, íconos)
RewriteRule ^assets/(.*)$ Frontend/public/assets/$1 [L]
RewriteRule ^favicon\.svg$ Frontend/public/favicon.svg [L]

# Nunca exponer código, configuración ni scripts SQL
RewriteRule ^(Bakend|Docs|Frontend/views|\.env|\.git) - [F,L]

# El resto lo atiende PHP
RewriteCond %{REQUEST_URI} !^/Frontend/public/
RewriteRule ^ api/index.php [L,QSA]
