# Apache (XAMPP / Laragon): todo pasa por el controlador frontal
Options -Indexes
RewriteEngine On

# Archivos públicos (CSS, JS, íconos)
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^favicon\.svg$ public/favicon.svg [L]

# Nunca exponer código, configuración ni scripts SQL
RewriteRule ^(app|Bakend|Docs|frontend|\.env|\.git) - [F,L]

# El resto lo atiende PHP
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^ api/index.php [L,QSA]
