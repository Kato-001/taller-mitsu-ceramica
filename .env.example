# Copie este archivo como .env y complete sus datos. El .env NUNCA se sube a GitHub.
APP_ENV=local
# Conexión de la aplicación: usuario de mínimo privilegio mitsu_app (pooler de Supabase, modo transacción)
DATABASE_URL=postgresql://mitsu_app.REF_PROYECTO:CLAVE@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Ejemplo local (Laragon/XAMPP con PostgreSQL): postgresql://mitsu_app:CLAVE@localhost:5432/taller_mitsu?sslmode=disable

# Solo para instalar los scripts SQL con Bakend/database/ejecutar.php (no se configura en Vercel)
DB_OWNER_URL=postgresql://mitsu_owner.REF_PROYECTO:CLAVE@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
APP_DB_PASSWORD=CLAVE_DE_mitsu_app

# Correo para recuperar contraseña (Gmail con "contraseña de aplicación" de 16 letras)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=correo_del_taller@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=Taller Mitsü
