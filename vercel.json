{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "regions": ["gru1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "excludeFiles": "{Docs/**,Bakend/database/**,node_modules/**,.git/**}"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/Frontend/public/assets/$1", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/favicon.svg", "dest": "/Frontend/public/favicon.svg" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
